#: array.c:248
#, c-format
msgid "from %s"
msgstr "從 %s"

#: array.c:365
msgid "attempt to use a scalar value as array"
msgstr "嘗試將純量值當作陣列使用"

#: array.c:367
#, c-format
msgid "attempt to use scalar parameter `%s' as an array"
msgstr "嘗試將純量參數「%s」當作陣列使用"

#: array.c:370
#, c-format
msgid "attempt to use scalar `%s' as an array"
msgstr "嘗試將純量「%s」當作陣列使用"

#: array.c:417 array.c:608 builtin.c:82 builtin.c:1135 builtin.c:1162
#: eval.c:1174 eval.c:1179 eval.c:1587 printf.c:774 printf.c:822 printf.c:835
#, c-format
msgid "attempt to use array `%s' in a scalar context"
msgstr "嘗試在純量脈絡中使用陣列「%s」"

#: array.c:615
#, c-format
msgid "delete: index `%.*s' not in array `%s'"
msgstr "delete：索引「%.*s」不在陣列「%s」中"

#: array.c:629
#, c-format
msgid "attempt to use scalar `%s[\"%.*s\"]' as an array"
msgstr "嘗試將純量「%s[\"%.*s\"]」當作陣列使用"

#: array.c:855 array.c:905
#, c-format
msgid "%s: first argument is not an array"
msgstr "%s：第一個引數不是陣列"

#: array.c:897
#, c-format
msgid "%s: second argument is not an array"
msgstr "%s：第二個引數不是陣列"

#: array.c:900 field.c:1149 field.c:1282
#, c-format
msgid "%s: cannot use %s as second argument"
msgstr "%s：無法將 %s 當作第二個引數"

#: array.c:908
#, c-format
msgid "%s: first argument cannot be SYMTAB without a second argument"
msgstr "%s：沒有第二個引數時，第一個引數不能是 SYMTAB"

#: array.c:910
#, c-format
msgid "%s: first argument cannot be FUNCTAB without a second argument"
msgstr "%s：沒有第二個引數時，第一個引數不能是 FUNCTAB"

#: array.c:917
msgid "asort/asorti: using the same array as source and destination without a third argument is silly."
msgstr "asort/asorti：在沒有第三引數的情況下，將同一個陣列同時作為來源和目的地是一件愚蠢的事。"

#: array.c:922
#, c-format
msgid "%s: cannot use a subarray of first argument for second argument"
msgstr "%s：無法使用第一個引數的子陣列作為第二個引數"

#: array.c:927
#, c-format
msgid "%s: cannot use a subarray of second argument for first argument"
msgstr "%s：無法使用第二個引數的子陣列作為第一個引數"

#: array.c:1457
#, c-format
msgid "`%s' is invalid as a function name"
msgstr "「%s」不是合法的函式名稱"

#: array.c:1461
#, c-format
msgid "sort comparison function `%s' is not defined"
msgstr "排序比較函式「%s」未定義"

#: awkgram.y:280
#, c-format
msgid "%s blocks must have an action part"
msgstr "%s 區塊必須有動作部分"

#: awkgram.y:283
msgid "each rule must have a pattern or an action part"
msgstr "每個規則必須有模式或動作部分"

#: awkgram.y:447 awkgram.y:459
msgid "old awk does not support multiple `BEGIN' or `END' rules"
msgstr "舊版 awk 不支援多個 BEGIN 或 END 規則"

#: awkgram.y:512
#, c-format
msgid "`%s' is a built-in function, it cannot be redefined"
msgstr "「%s」是內建函式，無法重新定義"

#: awkgram.y:576
msgid "regexp constant `//' looks like a C++ comment, but is not"
msgstr "正規表示式常數 `//` 看起來像 C++ 註解，但實際上不是"

#: awkgram.y:580
#, c-format
msgid "regexp constant `/%s/' looks like a C comment, but is not"
msgstr "正規表示式常數 `/%s/` 看起來像 C 註解，但實際上不是"

#: awkgram.y:707
#, c-format
msgid "duplicate case values in switch body: %s"
msgstr "switch 主體中有重複的 case 值：%s"

#: awkgram.y:728
msgid "duplicate `default' detected in switch body"
msgstr "在 switch 主體中偵測到重複的 default"

#: awkgram.y:1064 awkgram.y:4477
msgid "`break' is not allowed outside a loop or switch"
msgstr "在迴圈或 switch 之外不允許使用 break"

#: awkgram.y:1074 awkgram.y:4469
msgid "`continue' is not allowed outside a loop"
msgstr "在迴圈之外不允許使用 continue"

#: awkgram.y:1085
#, c-format
msgid "`next' used in %s action"
msgstr "在 %s 動作中使用 next"

#: awkgram.y:1096
#, c-format
msgid "`nextfile' used in %s action"
msgstr "在 %s 動作中使用 nextfile"

#: awkgram.y:1124
msgid "`return' used outside function context"
msgstr "在函式脈絡之外使用 return"

#: awkgram.y:1198 awkgram.y:1237
msgid "plain `print' in BEGIN or END rule should probably be `print \"\"'"
msgstr "在 BEGIN 或 END 規則中，單純的 print 應該改為 print \"\""

#: awkgram.y:1274
msgid "`delete' is not allowed with SYMTAB"
msgstr "不允許對 SYMTAB 使用 delete"

#: awkgram.y:1276
msgid "`delete' is not allowed with FUNCTAB"
msgstr "不允許對 FUNCTAB 使用 delete"

#: awkgram.y:1420
msgid "multistage two-way pipelines don't work"
msgstr "多階段雙向管線無法運作"

#: awkgram.y:1422
msgid "concatenation as I/O `>' redirection target is ambiguous"
msgstr "以串接作為 I/O > 重新導向目標並不明確"

#: awkgram.y:1634
msgid "regular expression on right of assignment"
msgstr "指派右側有正規表示式"

#: awkgram.y:1649 awkgram.y:1662
msgid "regular expression on left of `~' or `!~' operator"
msgstr "~ 或 !~ 運算子左側有正規表示式"

#: awkgram.y:1679 awkgram.y:1829
msgid "old awk does not support the keyword `in' except after `for'"
msgstr "舊版 awk 除了在 for 之後，不支援 in 關鍵字"

#: awkgram.y:1689
msgid "regular expression on right of comparison"
msgstr "比較右側有正規表示式"

#: awkgram.y:1808
#, c-format
msgid "non-redirected `getline' invalid inside `%s' rule"
msgstr "未重新導向的 getline 在 %s 規則中無效"

#: awkgram.y:1811
msgid "non-redirected `getline' undefined inside END action"
msgstr "未重新導向的 getline 在 END 動作中未定義"

#: awkgram.y:1831
msgid "old awk does not support multidimensional arrays"
msgstr "舊版 awk 不支援多維陣列"

#: awkgram.y:1934
msgid "call of `length' without parentheses is not portable"
msgstr "呼叫 length 時未加括號，不具可攜性"

#: awkgram.y:2008
msgid "indirect function calls are a gawk extension"
msgstr "間接函式呼叫是 gawk 擴充功能"

#: awkgram.y:2021
#, c-format
msgid "cannot use special variable `%s' for indirect function call"
msgstr "無法使用特殊變數「%s」進行間接函式呼叫"

#: awkgram.y:2054
#, c-format
msgid "attempt to use non-function `%s' in function call"
msgstr "嘗試在函式呼叫中使用非函式的「%s」"

#: awkgram.y:2119
msgid "invalid subscript expression"
msgstr "無效的下標運算式"

#: awkgram.y:2496 awkgram.y:2516 gawkapi.c:275 gawkapi.c:292 msg.c:132
msgid "warning: "
msgstr "警告："

#: awkgram.y:2514 gawkapi.c:247 gawkapi.c:290 msg.c:164
msgid "fatal: "
msgstr "嚴重錯誤："

#: awkgram.y:2567
msgid "unexpected newline or end of string"
msgstr "意外的換列或字串結尾"

#: awkgram.y:2588
msgid "source files / command-line arguments must contain complete functions or rules"
msgstr "來源檔案／命令列引數必須包含完整的函式或規則"

#: awkgram.y:2872 awkgram.y:2951 awkgram.y:3188 debug.c:545 debug.c:561
#: debug.c:2889 debug.c:5262
#, c-format
msgid "cannot open source file `%s' for reading: %s"
msgstr "無法開啟來源檔案「%s」以進行讀取：%s"

#: awkgram.y:2873 awkgram.y:3015
#, c-format
msgid "cannot open shared library `%s' for reading: %s"
msgstr "無法開啟共用函式庫「%s」以進行讀取：%s"

#: awkgram.y:2875 awkgram.y:2952 awkgram.y:3016 builtin.c:130 debug.c:5413
msgid "reason unknown"
msgstr "原因不明"

#: awkgram.y:2884 awkgram.y:2908
#, c-format
msgid "cannot include `%s' and use it as a program file"
msgstr "無法同時 include「%s」並將其作為程式檔案使用"

#: awkgram.y:2897
#, c-format
msgid "already included source file `%s'"
msgstr "已 include 的來源檔案「%s」"

#: awkgram.y:2898
#, c-format
msgid "already loaded shared library `%s'"
msgstr "已載入的共用函式庫「%s」"

#: awkgram.y:2935
msgid "@include is a gawk extension"
msgstr "@include 是 gawk 擴充功能"

#: awkgram.y:2941
msgid "empty filename after @include"
msgstr "@include 後的檔案名稱為空"

#: awkgram.y:2996
msgid "@load is a gawk extension"
msgstr "@load 是 gawk 擴充功能"

#: awkgram.y:3002
msgid "empty filename after @load"
msgstr "@load 後的檔案名稱為空"

#: awkgram.y:3140
msgid "empty program text on command line"
msgstr "命令列為空的程式文字"

#: awkgram.y:3256 debug.c:470 debug.c:628
#, c-format
msgid "cannot read source file `%s': %s"
msgstr "無法讀取來源檔案「%s」：%s"

#: awkgram.y:3267
#, c-format
msgid "source file `%s' is empty"
msgstr "來源檔案「%s」為空"

#: awkgram.y:3327
#, c-format
msgid "error: invalid character '\\%03o' in source code"
msgstr "錯誤：來源代碼中有無效字元「\\%03o」"

#: awkgram.y:3554
msgid "source file does not end in newline"
msgstr "來源檔案未以換列結尾"

#: awkgram.y:3665
msgid "unterminated regexp ends with `\\' at end of file"
msgstr "未完結的正規表示式以 \\ 結尾，位於檔案末尾"

#: awkgram.y:3694
msgid "unterminated regexp"
msgstr "未完結的正規表示式"

#: awkgram.y:3698
msgid "unterminated regexp at end of file"
msgstr "檔案末尾有未完結的正規表示式"

#: awkgram.y:3787
msgid "use of `\\ #...' line continuation is not portable"
msgstr "使用 \\ #... 換列延續不具可攜性"

#: awkgram.y:3809
msgid "backslash not last character on line"
msgstr "反斜線不是該列的最後一個字元"

#: awkgram.y:3857 awkgram.y:3859 field.c:1156 field.c:1289
msgid "multidimensional arrays are a gawk extension"
msgstr "多維陣列是 gawk 擴充功能"

#: awkgram.y:3884 awkgram.y:3895
#, c-format
msgid "POSIX does not allow operator `%s'"
msgstr "POSIX 不允許運算子「%s」"

#: awkgram.y:3886 awkgram.y:3897 awkgram.y:3932 awkgram.y:3940
#, c-format
msgid "operator `%s' is not supported in old awk"
msgstr "舊版 awk 不支援運算子「%s」"

#: awkgram.y:4037 awkgram.y:4059 command.y:1186
msgid "unterminated string"
msgstr "未完結的字串"

#: awkgram.y:4047 main.c:1245
msgid "POSIX does not allow physical newlines in string values"
msgstr "POSIX 不允許字串值中有實體換列"

#: awkgram.y:4049 node.c:481
msgid "backslash string continuation is not portable"
msgstr "反斜線字串延續不具可攜性"

#: awkgram.y:4301
#, c-format
msgid "invalid char '%c' in expression"
msgstr "運算式中有無效字元「%c」"

#: awkgram.y:4397
#, c-format
msgid "`%s' is a gawk extension"
msgstr "「%s」是 gawk 擴充功能"

#: awkgram.y:4402
#, c-format
msgid "POSIX does not allow `%s'"
msgstr "POSIX 不允許「%s」"

#: awkgram.y:4410
#, c-format
msgid "`%s' is not supported in old awk"
msgstr "舊版 awk 不支援「%s」"

#: awkgram.y:4514
msgid "`goto' considered harmful!"
msgstr "goto 被視為有害！"

#: awkgram.y:4583
#, c-format
msgid "%d is invalid as number of arguments for %s"
msgstr "%d 作為 %s 的引數數量無效"

#: awkgram.y:4618
#, c-format
msgid "%s: string literal as last argument of substitute has no effect"
msgstr "%s：以字串常值作為 substitute 的最後一個引數沒有效果"

#: awkgram.y:4623
#, c-format
msgid "%s third parameter is not a changeable object"
msgstr "%s 第三種參數不是可變更的物件"

#: awkgram.y:4726
msgid "match: regexp constant as first argument is probably not what you want"
msgstr "match：以正規表示式常數作為第一個引數可能不是您想要的"

#: awkgram.y:4735 awkgram.y:4738
msgid "match: third argument is a gawk extension"
msgstr "match：第三個引數是 gawk 擴充功能"

#: awkgram.y:4792 awkgram.y:4795
msgid "close: second argument is a gawk extension"
msgstr "close：第二個引數是 gawk 擴充功能"

#: awkgram.y:4807
msgid "use of dcgettext(_\"...\") is incorrect: remove leading underscore"
msgstr "使用 dcgettext(_\"...\") 不正確：請移除前底線"

#: awkgram.y:4822
msgid "use of dcngettext(_\"...\") is incorrect: remove leading underscore"
msgstr "使用 dcngettext(_\"...\") 不正確：請移除前底線"

#: awkgram.y:4841
msgid "index: regexp constant as second argument is not allowed"
msgstr "index：不允許以正規表示式常數作為第二個引數"

#: awkgram.y:4894
#, c-format
msgid "function `%s': parameter `%s' shadows global variable"
msgstr "函式「%s」：參數「%s」遮蔽了全域變數"

#: awkgram.y:4943 debug.c:4242 debug.c:4285 debug.c:5411 profile.c:115
#, c-format
msgid "could not open `%s' for writing: %s"
msgstr "無法開啟「%s」進行寫入：%s"

#: awkgram.y:4944
msgid "sending variable list to standard error"
msgstr "正在將變數列表傳送到標準錯誤"

#: awkgram.y:4952
#, c-format
msgid "%s: close failed: %s"
msgstr "%s：關閉失敗：%s"

#: awkgram.y:4977
msgid "shadow_funcs() called twice!"
msgstr "shadow_funcs() 被呼叫了兩次！"

#: awkgram.y:4985
msgid "there were shadowed variables"
msgstr "有被遮蔽的變數"

#: awkgram.y:5077
#, c-format
msgid "function name `%s' previously defined"
msgstr "函式名稱「%s」先前已定義"

#: awkgram.y:5128
#, c-format
msgid "function `%s': cannot use function name as parameter name"
msgstr "函式「%s」：不能將函式名稱用作參數名稱"

#: awkgram.y:5131
#, c-format
msgid "function `%s': parameter `%s': POSIX disallows using a special variable as a function parameter"
msgstr "函式「%s」：參數「%s」：POSIX 不允許使用特殊變數作為函式參數"

#: awkgram.y:5135
#, c-format
msgid "function `%s': parameter `%s' cannot contain a namespace"
msgstr "函式「%s」：參數「%s」不能包含命名空間"

#: awkgram.y:5142
#, c-format
msgid "function `%s': parameter #%d, `%s', duplicates parameter #%d"
msgstr "函式「%s」：參數 #%d「%s」重複了參數 #%d"

#: awkgram.y:5231
#, c-format
msgid "function `%s' called but never defined"
msgstr "函式「%s」被呼叫但從未定義"

#: awkgram.y:5235
#, c-format
msgid "function `%s' defined but never called directly"
msgstr "函式「%s」已定義但從未被直接呼叫"

#: awkgram.y:5267
#, c-format
msgid "regexp constant for parameter #%d yields boolean value"
msgstr "參數 #%d 的正規表示式常數產生布林值"

#: awkgram.y:5282
#, c-format
msgid ""
"function `%s' called with space between name and `(',\n"
"or used as a variable or an array"
msgstr ""
"呼叫函式「%s」時名稱與「(」之間有空格，\n"
"或用作變數或陣列"

#: awkgram.y:5512 awkgram.y:5575
msgid "division by zero may occur at runtime"
msgstr "執行時可能發生除以零"

#: awkgram.y:5526 awkgram.y:5589
#, c-format
msgid "division by zero in `%%' may occur at runtime"
msgstr "執行時 `%%` 可能發生除以零"

#: awkgram.y:5910
msgid "cannot assign a value to the result of a field post-increment expression"
msgstr "無法指派值給欄位後置遞增運算式的結果"

#: awkgram.y:5913
#, c-format
msgid "invalid target of assignment (opcode %s)"
msgstr "指派的目標無效（opcode %s）"

#: awkgram.y:6293
msgid "statement has no effect"
msgstr "陳述沒有效果"

#: awkgram.y:6808
#, c-format
msgid "identifier %s: qualified names not allowed in traditional / POSIX mode"
msgstr "標識符 %s：在傳統 / POSIX 模式下不允許使用限定名稱"

#: awkgram.y:6813
#, c-format
msgid "identifier %s: namespace separator is two colons, not one"
msgstr "標識符 %s：命名空間分隔符是兩個冒號，不是一個"

#: awkgram.y:6819
#, c-format
msgid "qualified identifier `%s' is badly formed"
msgstr "限定標識符「%s」格式不良"

#: awkgram.y:6826
#, c-format
msgid "identifier `%s': namespace separator can only appear once in a qualified name"
msgstr "標識符「%s」：命名空間分隔符在限定名稱中只能出現一次"

#: awkgram.y:6875 awkgram.y:6926
#, c-format
msgid "using reserved identifier `%s' as a namespace is not allowed"
msgstr "不允許使用保留標識符「%s」作為命名空間"

#: awkgram.y:6882 awkgram.y:6892
#, c-format
msgid "using reserved identifier `%s' as second component of a qualified name is not allowed"
msgstr "不允許使用保留標識符「%s」作為限定名稱的第二個元件"

#: awkgram.y:6910
msgid "@namespace is a gawk extension"
msgstr "@namespace 是 gawk 擴充"

#: awkgram.y:6917
#, c-format
msgid "namespace name `%s' must meet identifier naming rules"
msgstr "命名空間名稱「%s」必須符合標識符命名規則"

#: builtin.c:92 builtin.c:99
#, c-format
msgid "%s: called with %d arguments"
msgstr "%s：以 %d 個引數呼叫"

#: builtin.c:124
#, c-format
msgid "%s to \"%s\" failed: %s"
msgstr "對「%s」執行 %s 失敗：%s"

#: builtin.c:128
msgid "standard output"
msgstr "標準輸出"

#: builtin.c:129
msgid "standard error"
msgstr "標準錯誤"

#: builtin.c:205 builtin.c:543 builtin.c:645 builtin.c:666 builtin.c:1420
#: builtin.c:1438 builtin.c:1557 builtin.c:2637 mpfr.c:829
#, c-format
msgid "%s: received non-numeric argument"
msgstr "%s：收到非數字引數"

#: builtin.c:211
#, c-format
msgid "exp: argument %g is out of range"
msgstr "exp：引數 %g 超出範圍"

#: builtin.c:275 builtin.c:614 builtin.c:1020 builtin.c:1082 builtin.c:1329
#: builtin.c:1362
#, c-format
msgid "%s: received non-string argument"
msgstr "%s：收到非字串引數"

#: builtin.c:292
#, c-format
msgid "fflush: cannot flush: pipe `%.*s' opened for reading, not writing"
msgstr "fflush：無法沖刷：管線「%.*s」已開啟供讀取，不是寫入"

#: builtin.c:295
#, c-format
msgid "fflush: cannot flush: file `%.*s' opened for reading, not writing"
msgstr "fflush：無法沖刷：檔案「%.*s」已開啟供讀取，不是寫入"

#: builtin.c:306
#, c-format
msgid "fflush: cannot flush file `%.*s': %s"
msgstr "fflush：無法沖刷檔案「%.*s」：%s"

#: builtin.c:311
#, c-format
msgid "fflush: cannot flush: two-way pipe `%.*s' has closed write end"
msgstr "fflush：無法沖刷：雙向管線「%.*s」已關閉寫入端"

#: builtin.c:317
#, c-format
msgid "fflush: `%.*s' is not an open file, pipe or co-process"
msgstr "fflush：「%.*s」不是已開啟的檔案、管線或共同處理程序"

#: builtin.c:426 builtin.c:704 builtin.c:914 builtin.c:1599 builtin.c:2914
#: builtin.c:3001 builtin.c:3068
#, c-format
msgid "%s: received non-string first argument"
msgstr "%s：收到非字串第一個引數"

#: builtin.c:428 builtin.c:2892 builtin.c:2907 builtin.c:2997 builtin.c:3059
#, c-format
msgid "%s: received non-string second argument"
msgstr "%s：收到非字串第二個引數"

#: builtin.c:648 builtin.c:670
#, c-format
msgid "%s: received negative argument %g"
msgstr "%s：收到負數引數 %g"

#: builtin.c:691 builtin.c:2990
#, c-format
msgid "%s: received non-numeric third argument"
msgstr "%s：收到非數字第三個引數"

#: builtin.c:698 builtin.c:888 builtin.c:1399 builtin.c:2455 builtin.c:2501
