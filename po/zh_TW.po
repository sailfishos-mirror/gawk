#: command.y:818
msgid "backtrace [N] - print trace of all or N innermost (outermost if N < 0) frames"
msgstr "backtrace [N] - 印出全部或最內層 N 個（若 N < 0 則是最外層）框架的追蹤"

#: command.y:820
msgid "break [[filename:]N|function] - set breakpoint at the specified location"
msgstr "break [[filename:]N|function] - 在指定位置設定中斷點"

#: command.y:822
msgid "clear [[filename:]N|function] - delete breakpoints previously set"
msgstr "clear [[filename:]N|function] - 刪除先前設定的中斷點"

#: command.y:824
msgid "commands [num] - starts a list of commands to be executed at a breakpoint(watchpoint) hit"
msgstr "commands [num] - 開始列出在中斷點（監看點）觸發時要執行的指令"

#: command.y:826
msgid "condition num [expr] - set or clear breakpoint or watchpoint condition"
msgstr "condition num [expr] - 設定或清除中斷點或監看點條件"

#: command.y:828
msgid "continue [COUNT] - continue program being debugged"
msgstr "continue [COUNT] - 繼續執行正在除錯的程式"

#: command.y:830
msgid "delete [breakpoints] [range] - delete specified breakpoints"
msgstr "delete [breakpoints] [range] - 刪除指定的中斷點"

#: command.y:832
msgid "disable [breakpoints] [range] - disable specified breakpoints"
msgstr "disable [breakpoints] [range] - 停用指定的中斷點"

#: command.y:834
msgid "display [var] - print value of variable each time the program stops"
msgstr "display [var] - 每次程式停止時印出變數值"

#: command.y:836
msgid "down [N] - move N frames down the stack"
msgstr "down [N] - 在堆疊中向下移動 N 個框架"

#: command.y:838
msgid "dump [filename] - dump instructions to file or stdout"
msgstr "dump [filename] - 將指令傾印至檔案或 stdout"

#: command.y:840
msgid "enable [once|del] [breakpoints] [range] - enable specified breakpoints"
msgstr "enable [once|del] [breakpoints] [range] - 啟用指定的中斷點"

#: command.y:842
msgid "end - end a list of commands or awk statements"
msgstr "end - 結束指令或 awk 陳述式列表"

#: command.y:844
msgid "eval stmt|[p1, p2, ...] - evaluate awk statement(s)"
msgstr "eval stmt|[p1, p2, ...] - 評估 awk 陳述式"

#: command.y:846
msgid "exit - (same as quit) exit debugger"
msgstr "exit - （與 quit 相同）離開除錯器"

#: command.y:848
msgid "finish - execute until selected stack frame returns"
msgstr "finish - 執行直到選取的堆疊框架返回"

#: command.y:850
msgid "frame [N] - select and print stack frame number N"
msgstr "frame [N] - 選取並印出堆疊框架編號 N"

#: command.y:852
msgid "help [command] - print list of commands or explanation of command"
msgstr "help [command] - 印出指令列表或指令說明"

#: command.y:854
msgid "ignore N COUNT - set ignore-count of breakpoint number N to COUNT"
msgstr "ignore N COUNT - 設定中斷點編號 N 的忽略計數為 COUNT"

#: command.y:856
msgid "info topic - source|sources|variables|functions|break|frame|args|locals|display|watch"
msgstr "info topic - source|sources|variables|functions|break|frame|args|locals|display|watch"

#: command.y:858
msgid "list [-|+|[filename:]lineno|function|range] - list specified line(s)"
msgstr "list [-|+|[filename:]lineno|function|range] - 列出指定的列"

#: command.y:860
msgid "next [COUNT] - step program, proceeding through subroutine calls"
msgstr "next [COUNT] - 逐步執行程式，通過副常式呼叫繼續"

#: command.y:862
msgid "nexti [COUNT] - step one instruction, but proceed through subroutine calls"
msgstr "nexti [COUNT] - 逐步執行一個指令，但通過副常式呼叫繼續"

#: command.y:864
msgid "option [name[=value]] - set or display debugger option(s)"
msgstr "option [name[=value]] - 設定或顯示除錯器選項"

#: command.y:866
msgid "print var [var] - print value of a variable or array"
msgstr "print var [var] - 印出變數或陣列的值"

#: command.y:868
msgid "printf format, [arg], ... - formatted output"
msgstr "printf format, [arg], ... - 格式化輸出"

#: command.y:870
msgid "quit - exit debugger"
msgstr "quit - 離開除錯器"

#: command.y:872
msgid "return [value] - make selected stack frame return to its caller"
msgstr "return [value] - 讓選取的堆疊框架返回其呼叫者"

#: command.y:874
msgid "run - start or restart executing program"
msgstr "run - 啟動或重新啟動程式執行"

#: command.y:877
msgid "save filename - save commands from the session to file"
msgstr "save filename - 將工作階段中的指令儲存至檔案"

#: command.y:880
msgid "set var = value - assign value to a scalar variable"
msgstr "set var = value - 將值指派給純量變數"

#: command.y:882
msgid "silent - suspends usual message when stopped at a breakpoint/watchpoint"
msgstr "silent - 在中斷點/監看點停止時暫停一般訊息"

#: command.y:884
msgid "source file - execute commands from file"
msgstr "source file - 從檔案執行指令"

#: command.y:886
msgid "step [COUNT] - step program until it reaches a different source line"
msgstr "step [COUNT] - 逐步執行程式直到到達不同的來源列"

#: command.y:888
msgid "stepi [COUNT] - step one instruction exactly"
msgstr "stepi [COUNT] - 逐步執行一個指令"

#: command.y:890
msgid "tbreak [[filename:]N|function] - set a temporary breakpoint"
msgstr "tbreak [[filename:]N|function] - 設定暫時中斷點"

#: command.y:892
msgid "trace on|off - print instruction before executing"
msgstr "trace on|off - 執行前印出指令"

#: command.y:894
msgid "undisplay [N] - remove variable(s) from automatic display list"
msgstr "undisplay [N] - 從自動顯示列表移除變數"

#: command.y:896
msgid "until [[filename:]N|function] - execute until program reaches a different line or line N within current frame"
msgstr "until [[filename:]N|function] - 執行直到程式到達不同的列或目前框架中的第 N 列"

#: command.y:898
msgid "unwatch [N] - remove variable(s) from watch list"
msgstr "unwatch [N] - 從監看列表移除變數"

#: command.y:900
msgid "up [N] - move N frames up the stack"
msgstr "up [N] - 在堆疊中向上移動 N 個框架"

#: command.y:902
msgid "watch var - set a watchpoint for a variable"
msgstr "watch var - 為變數設定監看點"

#: command.y:904
msgid "where [N] - (same as backtrace) print trace of all or N innermost (outermost if N < 0) frames"
msgstr "where [N] - （與 backtrace 相同）印出全部或最內層 N 個（若 N < 0 則是最外層）框架的追蹤"

