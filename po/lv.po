msgid "list [-|+|[filename:]lineno|function|range] - list specified line(s)"
msgstr ""
"list [-|+|[filename:]lineno|function|range] - izdrukāt norādītās rindas"

#: command.y:860
msgid "next [COUNT] - step program, proceeding through subroutine calls"
msgstr ""
"next [COUNT] - izpildīt nākamo programmas soli, pārejot pāri apakšprogrammu "
"izsaukumiem"

#: command.y:862
msgid ""
"nexti [COUNT] - step one instruction, but proceed through subroutine calls"
msgstr ""
"nexti [COUNT] - izpildīt vienu instrukciju, pārejot pāri apakšprogrammu "
"izsaukumiem"

#: command.y:864
msgid "option [name[=value]] - set or display debugger option(s)"
msgstr "option [name[=value]] - iestatīt vai parādīt atkļūdotāja opciju(s)"

#: command.y:866
msgid "print var [var] - print value of a variable or array"
msgstr "print var [var] - izdrukāt mainīgā vai masīva vērtību"

