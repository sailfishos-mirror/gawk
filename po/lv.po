#, c-format
msgid "%s: first argument cannot be SYMTAB without a second argument"
msgstr "%s: pirmais arguments nevar būt SYMTAB bez otrā argumenta"

#: array.c:917
#, c-format
msgid "%s: first argument cannot be FUNCTAB without a second argument"
msgstr "%s: pirmais arguments nevar būt FUNCTAB bez otrā argumenta"

#: array.c:924
msgid ""
"asort/asorti: using the same array as source and destination without a third "
"argument is silly."
msgstr ""
"asort/asorti: viena un tā paša masīva izmantošana kā avotu un mērķi bez "
"trešā argumenta ir muļķīga."

#: array.c:929
#, c-format
msgid "%s: cannot use a subarray of first argument for second argument"
msgstr "%s: nevar izmantot pirmā argumenta apakšmasīvu kā otro argumentu"

#: array.c:934
#, c-format
msgid "%s: cannot use a subarray of second argument for first argument"
msgstr "%s: nevar izmantot otrā argumenta apakšmasīvu kā pirmo argumentu"

#: array.c:1464
#, c-format
msgid "`%s' is invalid as a function name"
msgstr "`%s' ir nederīgs kā funkcijas nosaukums"

#: array.c:1468
#, c-format
msgid "sort comparison function `%s' is not defined"
msgstr "kārtošanas salīdzināšanas funkcija `%s' nav definēta"

#: awkgram.y:278
#, c-format
msgid "%s blocks must have an action part"
msgstr "%s blokiem ir jābūt darbības daļai"

