#, c-format
msgid "duplicate case values in switch body: %s"
msgstr "dublētas case vērtības switch struktūrā: %s"

#: awkgram.y:704
msgid "duplicate `default' detected in switch body"
msgstr "dublēts `default' switch struktūrā"

