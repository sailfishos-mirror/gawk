#: awkgram.y:4338
#, c-format
msgid "`%s' is a gawk extension"
msgstr "`%s' ir gawk paplašinājums"

#: awkgram.y:4343
#, c-format
msgid "POSIX does not allow `%s'"
msgstr "POSIX nepieļauj `%s'"

