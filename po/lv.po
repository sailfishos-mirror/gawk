#: command.y:820
msgid ""
"break [[filename:]N|function] - set breakpoint at the specified location"
msgstr ""
"break [[filename:]N|function] - iestatīt pārtraukuma punktu norādītajā vietā"

#: command.y:822
msgid "clear [[filename:]N|function] - delete breakpoints previously set"
msgstr ""
"clear [[filename:]N|function] - dzēst iepriekš iestatītos pārtraukuma punktus"

