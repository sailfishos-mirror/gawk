msgstr ""
"commands [num] - sāk komandu sarakstu, kas jāizpilda, sasniedzot pārtraukuma "
"punktu (novērošanas punktu)"

#: command.y:826
msgid "condition num [expr] - set or clear breakpoint or watchpoint condition"
msgstr ""
"condition num [expr] - iestatīt vai noņemt pārtraukuma punkta vai "
"novērošanas punkta nosacījumu"

#: command.y:828
msgid "continue [COUNT] - continue program being debugged"
msgstr "continue [COUNT] - turpināt atkļūdojamo programmu"

