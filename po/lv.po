#: array.c:248
#, c-format
msgid "from %s"
msgstr "no %s"

#: array.c:365
msgid "attempt to use a scalar value as array"
msgstr "mēģinājums izmantot skalāru vērtību kā masīvu"

#: array.c:367
#, c-format
msgid "attempt to use scalar parameter `%s' as an array"
msgstr "mēģinājums izmantot skalāru parametru `%s' kā masīvu"

#: array.c:370
#, c-format
msgid "attempt to use scalar `%s' as an array"
msgstr "mēģinājums izmantot skalāru `%s' kā masīvu"

