#, c-format
msgid "`next' used in %s action"
msgstr "`next' lietots %s darbībā"

#: awkgram.y:1065
#, c-format
msgid "`nextfile' used in %s action"
msgstr "`nextfile' lietots %s darbībā"

#: awkgram.y:1093
msgid "`return' used outside function context"
msgstr "`return' lietots ārpus funkcijas konteksta"

#: awkgram.y:1167 awkgram.y:1206
msgid "plain `print' in BEGIN or END rule should probably be `print \"\"'"
msgstr ""
"vienkāršs `print' BEGIN vai END noteikumā, iespējams, jāaizstāj ar `print "
"\"\"'"

#: awkgram.y:1243
msgid "`delete' is not allowed with SYMTAB"
msgstr "`delete' nav atļauts lietot ar SYMTAB"

#: awkgram.y:1245
msgid "`delete' is not allowed with FUNCTAB"
msgstr "`delete' nav atļauts lietot ar FUNCTAB"

#: awkgram.y:1389
msgid "multistage two-way pipelines don't work"
msgstr "vairākpakāpju divvirzienu konveijeri nedarbojas"

#: awkgram.y:1391
msgid "concatenation as I/O `>' redirection target is ambiguous"
msgstr "konkatenācija kā I/O `>' novirzīšanas mērķis ir neviennozīmīga"

#: awkgram.y:1603
msgid "regular expression on right of assignment"
msgstr "regulārā izteiksme piešķiršanas labajā pusē"

#: awkgram.y:1618 awkgram.y:1631
msgid "regular expression on left of `~' or `!~' operator"
msgstr "regulārā izteiksme `~' vai `!~' operatora kreisajā pusē"

#: awkgram.y:1655
msgid "regular expression on right of comparison"
msgstr "regulārā izteiksme salīdzinājuma labajā pusē"

#: awkgram.y:1774
#, c-format
msgid "non-redirected `getline' invalid inside `%s' rule"
msgstr "nenovirzīts `getline' ir nederīgs `%s' noteikumā"

#: awkgram.y:1777
msgid "non-redirected `getline' undefined inside END action"
msgstr "nenovirzītais `getline' nav definēts END darbībā"

#: awkgram.y:1893
msgid "call of `length' without parentheses is not portable"
msgstr "`length' izsaukšana bez iekavām nav pārnesama"

#: awkgram.y:1967
msgid "indirect function calls are a gawk extension"
msgstr "netiešie funkciju izsaukumi ir gawk paplašinājums"

#: awkgram.y:1980
#, c-format
msgid "cannot use special variable `%s' for indirect function call"
msgstr "nevar izmantot īpašo mainīgo `%s' netiešam funkcijas izsaukumam"

#: awkgram.y:2013
#, c-format
msgid "attempt to use non-function `%s' in function call"
msgstr "mēģināts izmantot nefunkciju `%s' funkcijas izsaukumā"

#: awkgram.y:2078
msgid "invalid subscript expression"
msgstr "nederīga indeksa izteiksme"

#: awkgram.y:2451 awkgram.y:2471 gawkapi.c:262 gawkapi.c:277 msg.c:132
msgid "warning: "
msgstr "brīdinājums: "

#: awkgram.y:2469 gawkapi.c:238 gawkapi.c:275 msg.c:164
msgid "fatal: "
msgstr "fatāla kļūda: "

#: awkgram.y:2522
msgid "unexpected newline or end of string"
msgstr "negaidīta jauna rinda vai virknes beigas"

#: awkgram.y:2543
msgid ""
"source files / command-line arguments must contain complete functions or "
"rules"
msgstr ""
"avota failiem / komandrindas argumentiem jāsatur pilnīgas funkcijas vai "
"noteikumi"

#: awkgram.y:2827 awkgram.y:2906 awkgram.y:3143 debug.c:545 debug.c:561
#: debug.c:2889 debug.c:5266
