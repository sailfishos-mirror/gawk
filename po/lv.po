msgid "printf format, [arg], ... - formatted output"
msgstr "printf format, [arg], ... - formatēta izvade"

#: command.y:870
msgid "quit - exit debugger"
msgstr "quit - iziet no atkļūdotāja"

#: command.y:872
msgid "return [value] - make selected stack frame return to its caller"
msgstr ""
"return [value] - likt izvēlētajam steka rāmim atgriezties pie tā izsaucēja"

