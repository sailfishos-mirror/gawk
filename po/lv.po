msgid "each rule must have a pattern or an action part"
msgstr "katram noteikumam ir jābūt šablonam vai darbības daļai"

#: awkgram.y:498
#, c-format
msgid "`%s' is a built-in function, it cannot be redefined"
msgstr "`%s' ir iebūvēta funkcija, to nevar pārdefinēt"

