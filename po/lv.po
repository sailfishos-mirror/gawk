#: awkgram.y:6802 awkgram.y:6812
#, c-format
msgid ""
"using reserved identifier `%s' as second component of a qualified name is "
"not allowed"
msgstr ""
"rezervēto identifikatoru `%s' nav atļauts izmantot kā kvalificēta nosaukuma "
"otro komponentu"

#: awkgram.y:6830
msgid "@namespace is a gawk extension"
msgstr "@namespace ir gawk paplašinājums"

#: awkgram.y:6837
#, c-format
msgid "namespace name `%s' must meet identifier naming rules"
msgstr ""
"nosaukumvietas nosaukumam `%s' jāatbilst identifikatoru nosaukšanas "
"noteikumiem"

