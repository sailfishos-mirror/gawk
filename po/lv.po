#, c-format
msgid "qualified identifier `%s' is badly formed"
msgstr "kvalificētais identifikators `%s' ir nepareizi veidots"

#: awkgram.y:6746
#, c-format
msgid ""
"identifier `%s': namespace separator can only appear once in a qualified name"
