msgid "run - start or restart executing program"
msgstr "run - sākt vai atsākt programmas izpildi"

#: command.y:877
msgid "save filename - save commands from the session to file"
msgstr "save filename - saglabāt sesijas komandas failā"

#: command.y:880
msgid "set var = value - assign value to a scalar variable"
msgstr "set var = value - piešķirt vērtību skalāram mainīgajam"

#: command.y:882
msgid "silent - suspends usual message when stopped at a breakpoint/watchpoint"
msgstr ""
"silent - aptur parastos paziņojumus, apstājoties pie pārtraukumpunkta/"
