#, c-format
msgid "attempt to use scalar `%s[\"%.*s\"]' as an array"
msgstr "mēģinājums izmantot skalāru `%s[\"%.*s\"]' kā masīvu"

#: array.c:864 array.c:912
#, c-format
msgid "%s: first argument is not an array"
msgstr "%s: pirmais arguments nav masīvs"

#: array.c:904
#, c-format
msgid "%s: second argument is not an array"
msgstr "%s: otrais arguments nav masīvs"

#: array.c:907 field.c:1154 field.c:1287
#, c-format
msgid "%s: cannot use %s as second argument"
msgstr "%s: nevar izmantot %s kā otro argumentu"

